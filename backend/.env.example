# Configuración de Entorno - Botica Nova Salud (Backend)
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Secreto JWT para firma de tokens (mínimo 32 caracteres aleatorios)
JWT_SECRET=super_secreto_botica_nova_salud_2026_seguro_y_robusto_llave_maestra

# Cadena de conexión a PostgreSQL 16 local
# Formato: postgresql://<USUARIO>:<PASSWORD>@localhost:5432/<BASE_DE_DATOS>?schema=public
# Reemplaza <PASSWORD> con tu contraseña local de postgres
DATABASE_URL="postgresql://postgres:tu_password_aqui@localhost:5432/botica_novasalud?schema=public"
